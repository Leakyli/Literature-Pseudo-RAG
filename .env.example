# Elsevier Scopus Search API key — https://dev.elsevier.com/apikey/manage
ELSEVIER_API_KEY=your_api_key_here

# Email used for Unpaywall API attribution (no key required)
UNPAYWALL_EMAIL=your-email@example.com

# n8n webhook that receives PDF URLs from the researcher
N8N_WEBHOOK_URL=http://localhost:5678/webhook/fetch-paper

# URL of the PyMuPDF4LLM microservice as seen by n8n (Docker DNS)
PDF_SERVICE_URL=http://pdf_service:5001

# Optional: where the researcher creates topic folders, and the DOI dedup tracker
OUTPUT_DIR=./vault/Research & Syntheses
PROCESSED_DOIS_FILE=./processed_dois.txt